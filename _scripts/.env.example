# Gmail Configuration
# Copy this file to .env and fill in your actual credentials

# Your Gmail address
GMAIL_EMAIL=you@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# See GMAIL_SETUP.md for instructions on how to generate this
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Block captain details used by the order flyer (order_form.py) and the email template (mail_merge.py)
CAPTAIN_NAME="Your Name"
CAPTAIN_FIRST="Yourname"
CAPTAIN_ADDRESS="1234 Curtiss Ave"
CAPTAIN_EMAIL="you@gmail.com"
CAPTAIN_PHONE="(408) 555-0100"
CAPTAIN_VENMO="@your-venmo"
